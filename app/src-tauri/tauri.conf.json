{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OBSCura",
  "mainBinaryName": "obscura",
  "version": "0.1.0",
  "identifier": "io.github.kenvandine.obscura",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OBSCura",
        "width": 1280,
        "height": 760,
        "minWidth": 1000,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "Video",
    "shortDescription": "Unofficial control panel for OBSBOT webcams",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "copyright": "Copyright \u00a9 2026 Ken VanDine"
  }
}
