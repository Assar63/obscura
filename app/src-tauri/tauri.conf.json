{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OBSBOT Center",
  "mainBinaryName": "obsbot-center",
  "version": "0.1.0",
  "identifier": "io.github.kenvandine.obsbot-center",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OBSBOT Center",
        "width": 1280,
        "height": 760,
        "minWidth": 1000,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Video",
    "shortDescription": "Unofficial Linux control panel for OBSBOT webcams",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
