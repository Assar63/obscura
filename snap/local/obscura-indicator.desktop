[Desktop Entry]
Type=Application
Name=OBSCura Indicator
GenericName=Webcam Controls
Comment=Quick OBSBOT camera controls in the panel
Exec=obscura.indicator
Icon=${SNAP}/usr/share/icons/hicolor/256x256/apps/obscura.png
Terminal=false
# Started by the app (and at login); no separate launcher in the app grid.
NoDisplay=true
Categories=AudioVideo;Video;Settings;HardwareSettings;
Keywords=webcam;camera;obsbot;tray;indicator;tracking;
